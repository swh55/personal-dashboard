// Prisma schema for the Personal Business Dashboard
// PostgreSQL (Neon) — Multi-tenant: every data row is scoped to a userId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// USER MODEL (Multi-tenant root)
// ----------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  provider      String?   // "google", "credentials", ...
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations — every collection a user owns
  contacts          Contact[]
  callLogs          CallLog[]
  notes             Note[]
  events            Event[]
  tasks             Task[]
  expenses          Expense[]
  budgets           Budget[]
  assets            Asset[]
  accounts          Account[]
  debts             Debt[]
  projects          Project[]
  meetings          Meeting[]
  occasions         Occasion[]
  diaryEntries      DiaryEntry[]
  habits            Habit[]
  medications       Medication[]
  sleepLogs         SleepLog[]
  pantryItems       PantryItem[]
  waitingItems      WaitingItem[]
  savedLocations    SavedLocation[]
  contactReminders  ContactReminder[]
  happinessLogs     HappinessLog[]
  quranLogs         QuranLog[]
  integrations      Integration[]
  activityLogs      ActivityLog[]
  scheduledMessages ScheduledMessage[]
  automationRules   AutomationRule[]
  suggestions       Suggestion[]
  appSettings       AppSetting[]
  syncQueue         SyncQueue[]
}

// ----------------------------------------------------------------------------
// Core: Contacts & Calls
// ----------------------------------------------------------------------------
model Contact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  whatsapp  String?
  email     String?
  relation  String   @default("other") // family, friend, work, business, other
  category  String?
  note      String?
  favorite  Boolean  @default(false)
  avatar    String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls     CallLog[]
  reminders ContactReminder[]

  @@index([userId])
}

model CallLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name       String
  phone      String
  type       String   @default("call") // call, whatsapp, sms
  direction  String   @default("outgoing") // incoming, outgoing, missed
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Notes
// ----------------------------------------------------------------------------
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  color     String   @default("default") // default, yellow, green, blue, red, purple
  pinned    Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Calendar / Events
// ----------------------------------------------------------------------------
model Event {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean  @default(false)
  type        String   @default("personal") // work, personal, family, health, other
  color       String   @default("emerald") // emerald, amber, rose, blue, violet, slate
  location    String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Tasks
// ----------------------------------------------------------------------------
model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("todo") // todo, doing, done
  priority    String   @default("medium") // low, medium, high
  category    String   @default("general")
  dueDate     DateTime?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Expenses
// ----------------------------------------------------------------------------
model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String   @default("syp") // syp, usd
  category    String   @default("general")
  description String?
  date        DateTime @default(now())
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional link to the account this expense was paid from / transferred between.
  // SetNull on account delete so historical expense records survive.
  accountId   String?
  account     Account? @relation("AccountExpenses", fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Budgets
// ----------------------------------------------------------------------------
model Budget {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  limit     Float
  month     Int // 1-12
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, month, year])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Assets & Accounts
// ----------------------------------------------------------------------------
model Asset {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  amount      Float
  currency    String   @default("syp")
  type        String   @default("cash") // cash, bank, real-estate, gold, stocks, other
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Account {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  balance       Float
  currency      String   @default("syp")
  type          String   @default("bank") // bank, cash, savings, credit
  institution   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Expenses linked to this account (paid-from or transfer-leg records).
  expenses      Expense[] @relation("AccountExpenses")

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Debts
// ----------------------------------------------------------------------------
model Debt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personName  String
  amount      Float
  currency    String   @default("syp") // syp, usd
  type        String   @default("owed") // owed (for me), owe (against me)
  description String?
  dueDate     DateTime?
  settled     Boolean  @default(false)
  settledAt   DateTime?
  deletedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Projects
// ----------------------------------------------------------------------------
model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("active") // active, paused, completed, archived
  color       String   @default("emerald")
  progress    Int      @default(0) // 0-100
  startDate   DateTime?
  endDate     DateTime?
  tasks       Task[]
  checklist   ProjectChecklistItem[]
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model ProjectChecklistItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ----------------------------------------------------------------------------
// Meetings
// ----------------------------------------------------------------------------
model Meeting {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  agenda       String?
  notes        String?
  location     String?
  participants String? // comma separated names
  startDate    DateTime
  endDate      DateTime?
  status       String   @default("scheduled") // scheduled, completed, cancelled
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Occasions
// ----------------------------------------------------------------------------
model Occasion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  type      String   @default("birthday") // birthday, anniversary, holiday, other
  recurring Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Diary
// ----------------------------------------------------------------------------
model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  mood      String   @default("neutral") // happy, sad, neutral, angry, excited, anxious
  weather   String?
  date      DateTime @default(now())
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Habits
// ----------------------------------------------------------------------------
model Habit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  frequency   String   @default("daily") // daily, weekly
  target      Int      @default(1)
  color       String   @default("emerald")
  icon        String   @default("CheckCircle")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs        HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  value     Int      @default(1)
  note      String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

// ----------------------------------------------------------------------------
// Health: Medications & Sleep
// ----------------------------------------------------------------------------
model Medication {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  dosage      String?
  frequency   String   @default("daily")
  startDate   DateTime @default(now())
  endDate     DateTime?
  notes       String?
  active      Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model SleepLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  bedtime   DateTime?
  wakeTime  DateTime?
  duration  Int      @default(0) // in minutes
  quality   String   @default("good") // poor, fair, good, excellent
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Pantry / Home
// ----------------------------------------------------------------------------
model PantryItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int      @default(1)
  unit      String   @default("piece") // piece, kg, g, l, ml, pack
  lowStock  Int      @default(1)
  category  String   @default("other") // grains, dairy, meat, vegetables, fruits, beverages, cleaning, other
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Waiting List
// ----------------------------------------------------------------------------
model WaitingItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    Int      @default(0)
  ready       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Saved Locations
// ----------------------------------------------------------------------------
model SavedLocation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  address   String   @default("")
  lat       Float
  lng       Float
  icon      String   @default("MapPin")
  color     String   @default("blue")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Contact Reminders
// ----------------------------------------------------------------------------
model ContactReminder {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName    String
  frequency      String   @default("weekly") // daily, weekly, monthly
  lastContacted  DateTime?
  nextReminder   DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Happiness
// ----------------------------------------------------------------------------
model HappinessLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  score     Int // 1-10
  factors   String? // JSON
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Quran
// ----------------------------------------------------------------------------
model QuranLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surah     Int
  fromAyah  Int
  toAyah    Int
  juz       Int?
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Integrations
// ----------------------------------------------------------------------------
model Integration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   String   // google_calendar, google_drive, telegram, email, github, google_contacts, cloud_sync
  name      String
  connected Boolean  @default(false)
  config    String? // JSON
  lastSync  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, service])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Activity Log
// ----------------------------------------------------------------------------
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // create, update, delete, toggle, export, import, sync
  entity    String // contact, note, task, ...
  message   String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Scheduled Messages
// ----------------------------------------------------------------------------
model ScheduledMessage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient    String
  message      String
  channel      String   @default("whatsapp") // whatsapp, sms, telegram, email
  scheduledAt  DateTime
  sent         Boolean  @default(false)
  sentAt       DateTime?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Automation
// ----------------------------------------------------------------------------
model AutomationRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  trigger   String // event type
  action    String // action to perform
  config    String? // JSON
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Suggestions
// ----------------------------------------------------------------------------
model Suggestion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String   @default("general")
  status    String   @default("pending") // pending, accepted, rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Settings (key-value store, per-user)
// ----------------------------------------------------------------------------
model AppSetting {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  value  String

  @@unique([userId, key])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Sync Queue (server-side pending operations for offline-first sync)
// ----------------------------------------------------------------------------
model SyncQueue {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    String   // contact, note, task, ...
  entityId  String   // client-side id
  operation String   // create, update, delete
  payload   String   // JSON of the record
  status    String   @default("pending") // pending, syncing, failed, done
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// NOTE: NextAuth uses the JWT session strategy (not the Prisma adapter), so
// the standard Account/Session/VerificationToken tables are NOT required.
// User records are upserted on first Google login via the signIn callback
// in src/lib/auth.ts. The financial "Account" model above is unrelated.
