# =============================================================================
# ENVIRONMENT TEMPLATE — copy to .env and fill in real values.
# This file contains ONLY placeholder names; never put real secrets here.
# =============================================================================

# --- Neon PostgreSQL (cloud database) ---
# Get yours from https://neon.tech — use POOLED url for DATABASE_URL and DIRECT url for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Cloudinary (image / file uploads) ---
# Get yours from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- NextAuth (Google OAuth + session signing) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public app URL (used to compute NextAuth callbacks)
NEXTAUTH_URL="http://localhost:3000"

# --- Public client-safe flags (safe to expose to browser bundle) ---
NEXT_PUBLIC_APK_MODE="false"
