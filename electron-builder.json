{
  "appId": "com.abdullah.dashboard",
  "productName": "لوحة التحكم الشخصية",
  "copyright": "Copyright © 2025",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "out/**/*",
    "public/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/logo.svg"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "لوحة التحكم",
    "installerIcon": "public/logo.svg",
    "uninstallerIcon": "public/logo.svg",
    "installerHeaderIcon": "public/logo.svg"
  },
  "publish": {
    "provider": "github",
    "owner": "swh55",
    "repo": "personal-dashboard",
    "releaseType": "draft"
  }
}
