{
  "appId": "pro.datascoop.sela",
  "productName": "Silah",
  "copyright": "Copyright 2025",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "public/**/*"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "app-next"
    },
    {
      "from": ".next/static",
      "to": "app-next/.next/static"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Silah"
  }
}
